# CyberLab Academy Frontend — Environment Configuration
# Copy to .env.local (untracked) for local overrides.

# Upstream FastAPI backend target used by the Next.js server-side same-origin proxy (/api/v1/*).
# Never expose an internal backend address via NEXT_PUBLIC_* if it should remain server-proxied.
CYBERLAB_BACKEND_URL=http://127.0.0.1:8000

# Optional: Enable the explicitly labeled Cloud Preview Demo Mode selector when no local
# FastAPI instance is reachable (e.g., Arena cloud preview). Set to "false" in production.
NEXT_PUBLIC_ENABLE_PREVIEW_DEMO=true

# Maximum request body the same-origin /api/v1 proxy will buffer before returning 413.
# Defaults to 262144 (256 KiB); auth payloads are far smaller.
CYBERLAB_MAX_PROXY_BODY_BYTES=262144

# Only enable when a trusted front proxy (nginx, Cloudflare, ...) appends the real client
# address to X-Forwarded-For. When false the backend throttles on the proxy's own address.
CYBERLAB_TRUST_INBOUND_XFF=false
