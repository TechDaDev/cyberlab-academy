# Development defaults. Copy to an untracked local environment file if needed.
DATABASE_URL=sqlite:///./cyberlab-dev.sqlite3
COOKIE_SECURE=false
APP_ENV=development
BIND_HOST=127.0.0.1
BIND_PORT=8000
RELOAD=true
# Comma-separated peer addresses allowed to supply X-Forwarded-For. Login and recovery
# throttles key on this resolved client address. Leave empty when the API is called
# directly; set it to the reverse proxy / Next.js proxy address when one is deployed.
TRUSTED_PROXY_IPS=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FRONTEND_URL=http://localhost:3000
MAIL_PROVIDER=dev_capture
MAIL_CAPTURE_DIR=/tmp/cyberlab-mail
MANAGER_MFA_REQUIRED=false
# Generate a Fernet key outside version control before MFA enrollment:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MFA_ENCRYPTION_KEY=
# For SMTP delivery, set MAIL_PROVIDER=smtp and supply these values privately:
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASSWORD=  MAIL_FROM=
