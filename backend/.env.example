# Development defaults. Copy to an untracked local environment file if needed.
DATABASE_URL=sqlite:///./cyberlab-dev.sqlite3
COOKIE_SECURE=false
APP_ENV=development
BIND_HOST=127.0.0.1
BIND_PORT=8000
RELOAD=true
# Comma-separated *immediate peering* addresses allowed to supply X-Forwarded-For. The
# application resolves forwarded identity itself (Uvicorn proxy handling is disabled in
# app.run), so `request.client` always stays the real socket peer. Only a single, valid IP
# literal from a listed peer is accepted; multi-hop, malformed, or header-less requests
# yield no client identity and address-keyed throttles are skipped (fail safe, no shared
# lockout). Leave empty unless a sanitizing proxy connects directly to the API.
# Never run this app with `uvicorn --proxy-headers`: that rewrites the peer address the
# check depends on.
TRUSTED_PROXY_IPS=
# Bound on concurrent password hashing. Excess requests queue briefly, then receive 503
# with Retry-After instead of a counted lockout that could deny a shared address.
AUTH_HASH_CONCURRENCY=16
AUTH_HASH_QUEUE_SECONDS=2
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FRONTEND_URL=http://localhost:3000
MAIL_PROVIDER=dev_capture
MAIL_CAPTURE_DIR=/tmp/cyberlab-mail
MANAGER_MFA_REQUIRED=false
# Generate a Fernet key outside version control before MFA enrollment:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MFA_ENCRYPTION_KEY=
# For SMTP delivery, set MAIL_PROVIDER=smtp and supply these values privately:
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASSWORD=  MAIL_FROM=
